# File: .dockerignore
# Purpose: Define files and directories to exclude from the Docker build context
#          when building the *Flask WebApp* image.

# --- Git & Docker ---
.git
.gitignore
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml # Ignore local overrides
portainer_docker-compose.yml
*.yaml

# --- Python Virtual Environments ---
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# --- Python Cache & Compiled Files ---
__pycache__/
*.py[cod]
*.so

# --- IDE / Editor Specific ---
.idea/
.vscode/
*.sublime-*
*.iml

# --- Testing Artifacts ---
.pytest_cache/
.coverage*
htmlcov/
nosetests.xml
coverage.xml

# --- Build Artifacts ---
# Python
dist/
build/
*.egg-info/
*.egg
wheels/
# Android (in case they appear in context - less likely but safe)
*.apk
*.aab
*.ap_

# --- Data Directory (CRITICAL) ---
# Contains user data, handled by Docker Volume Mount.
# NEVER copy the host's data directory into the image during build.
data/

# --- Environment Files ---
# Contain secrets, handled by Volume Mount or Docker Env Vars.
.env
*.env.*
.envrc

# --- OS Specific Junk Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*~

# --- Documentation / Project Files (Not needed in runtime image) ---
README.md
TODO.md
LICENSE
docs/

# --- Development/Utility Scripts ---
# scripts/ # Uncomment if scripts are purely for dev

# --- Instance Folder (If used by Flask) ---
instance/

# --- Node Modules (If frontend dependencies are ever managed) ---
# node_modules/
# package-lock.json
# yarn.lock

# --- Other Cache/Temp Files ---
.mypy_cache/
.ruff_cache/
.pytype/
celerybeat-schedule
*.pid

# --- Android Project Source Code ---
# Exclude the entire Android project directory from the Flask build context.
# ** Adjust this directory name if your Android project folder is different! **
FindMyAndroid/

# --- Android Specific Files (If potentially at root) ---
.gradle/
local.properties
google-services.json

# --- Codebase Generation Files ---
codebase*.txt
codebase.py
codebase_log.log