# File: .gitignore
# Purpose: Specifies intentionally untracked files that Git should ignore.
#          Covers both Python/Flask WebApp and Android project files.

# --- Python Bytecode and Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Python Virtual Environments ---
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# --- Configuration / Secrets ---
# Environment variable files (use seeds in docker-compose.yml or env vars)
.env
*.env.*
.envrc

# User-specific sensitive data (Apple credentials, DB, cache)
# IMPORTANT: Do NOT commit the contents of the data directory!
data/

# Explicitly ignore specific sensitive files if accidentally placed outside data/
apple_credentials.json
*.pem
*.key
# IMPORTANT: Ignore Firebase config for Android app (contains project keys)
google-services.json
app/google-services.json

# --- IDE / Editor Configuration ---
.idea/
.vscode/
*.iml
*.project
*.classpath
*.settings/
*.sublime-*

# --- Build / Distribution Artifacts ---
# Python
dist/
build/
*.egg-info/
*.egg
wheels/
htmlcov/ # Coverage reports
# Android
*.apk
*.aab
*.ap_
*.dex
/app/build/ # Android module build directory

# --- Testing Artifacts ---
.pytest_cache/
.coverage
*.cover
nosetests.xml
coverage.xml
# Android Test Reports (often in app/build/reports)
/app/build/reports/
/app/build/test-results/
/app/build/outputs/androidTest-results/

# --- Runtime / Temporary Files ---
*.log
*.log.*
*.sqlite
*.sqlite3
# Celery / Task Queue files (if added later)
celerybeat-schedule
*.pid

# --- OS Specific Files ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
# Linux
*~
# KDE temp files
.~\$.*

# --- Instance Folder (Common Flask Pattern) ---
/instance/

# --- Node Modules (If frontend build tools are ever added) ---
# node_modules/
# npm-debug.log*
# yarn-debug.log*
# yarn-error.log*
# package-lock.json # Sometimes ignored, sometimes committed
# yarn.lock         # Sometimes ignored, sometimes committed

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints

# --- Miscellaneous ---
# MyPy / Ruff / Pytype Cache
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
# Pyenv
.python-version

# --- Docker ---
.docker/contexts/
# Ignore docker-compose variations if not templates
# docker-compose.yml # Keep committed
# portainer_docker-compose.yml # Keep committed
*.yaml

# --- Android Specific ---
.gradle/ # Project-level Gradle cache
captures/ # Android Studio captures
*.hprof # Heap dumps
# local.properties: Contains SDK path, potentially sensitive keys
local.properties
/app/local.properties
# NDK builds
.cxx/
/app/.cxx/

# --- Codebase Generation Files (Internal Use) ---
codebase.txt
codebase.py
codebase_log.log
codebase_*.txt