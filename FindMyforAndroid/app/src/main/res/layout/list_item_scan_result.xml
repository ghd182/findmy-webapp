<!-- File: app/src/main/res/layout/list_item_scan_result.xml -->
<!-- Language: XML -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Device Icon -->
    <ImageView
        android:id="@+id/scan_item_icon_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        tools:srcCompat="@drawable/ic_baseline_devices_24"
        app:tint="?attr/colorControlNormal"
        android:contentDescription="Device Icon" />

    <!-- Main Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/scan_item_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="My AirTag" />

        <TextView
            android:id="@+id/scan_item_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textSize="12sp"
            tools:text="RSSI: -55 dBm • Batt: Medium • Type: ROLLING" />
    </LinearLayout>

    <!-- Right Column: Time, Matched Indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/scan_item_last_seen_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textSize="11sp"
            tools:text="2 min ago" />

        <ImageView
            android:id="@+id/scan_item_matched_indicator_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            app:srcCompat="@drawable/ic_baseline_check_circle_24"
            app:tint="?attr/colorPrimary"
            android:visibility="visible"
            tools:visibility="visible"
            android:contentDescription="Matched Device"/>
    </LinearLayout>
</LinearLayout>